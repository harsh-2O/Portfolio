# Internship scanner — set in Vercel + GitHub Secrets (never commit real values)
# Scheduling runs via GitHub Actions (hourly). Vercel Hobby cannot use hourly crons.

CRON_SECRET=generate-a-long-random-string

# GitHub Actions secrets:
# INTERNSHIP_SCAN_URL=https://portfolio-delta-one-30.vercel.app/api/internship-scan
# CRON_SECRET=<same value as Vercel>

# Job search — at least one required
RAPIDAPI_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=harsh.mehta@tamu.edu

# Dedup store (recommended) — https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email via Resend — sends TO hdmehta406@gmail.com only
# Sign up: https://resend.com/ then verify hdmehta406@gmail.com as recipient
RESEND_API_KEY=
INTERNSHIP_ALERT_TO=hdmehta406@gmail.com
RESEND_FROM=onboarding@resend.dev
