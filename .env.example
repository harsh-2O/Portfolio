# Hourly internship scanner (server-only — set in Vercel, never commit real values)

# Protect cron endpoint (GitHub Actions + Vercel cron send this header)
CRON_SECRET=generate-a-long-random-string

# GitHub Actions secret — full URL to deployed scanner
# e.g. https://portfolio-delta-one-30.vercel.app/api/_s/internship-scan
INTERNSHIP_SCAN_URL=

# Job search — at least one required
# JSearch: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
# USAJobs: https://developer.usajobs.gov/
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=harsh.mehta@tamu.edu

# Dedup store (free tier) — https://upstash.com/
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email — use SMTP for @tamu.edu sender, or Resend with verified domain
INTERNSHIP_ALERT_TO=hdmehta406@gmail.com
INTERNSHIP_ALERT_FROM=harsh.mehta@tamu.edu
INTERNSHIP_ALERT_FROM_NAME=Harsh Mehta

# Option A: Microsoft Graph — send as harsh.mehta@tamu.edu (Azure app registration)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Option B: Resend (FROM must be a verified domain; set reply-to above)
RESEND_API_KEY=
